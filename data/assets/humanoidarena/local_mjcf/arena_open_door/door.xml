<mujoco model="humanoidarena_open_door">
  <compiler angle="radian" autolimits="true"/>
  <default>
    <geom condim="4" friction="0.8 0.02 0.002" solref="0.005 2"/>
  </default>
  <worldbody>
    <!--
      Collision proxy for model_door001_vali.usd.  Dimensions and hinge
      locations include the authored /root scale (1.2, 1.0, 0.78).  The
      original USD remains the render asset; MuJoCo owns all contacts.
    -->
    <body name="door_root">
      <geom name="hinge_post" type="box" pos="-0.527 -0.093 1.067"
            size="0.045 0.055 1.067" rgba="0.32 0.32 0.32 1"/>
      <geom name="latch_post" type="box" pos="0.542 -0.093 1.067"
            size="0.045 0.055 1.067" rgba="0.32 0.32 0.32 1"/>
      <geom name="header" type="box" pos="0.008 -0.093 2.175"
            size="0.580 0.055 0.045" rgba="0.32 0.32 0.32 1"/>

      <body name="leaf" pos="-0.4818004 -0.0241592 0.80106">
        <joint name="leaf_hinge" type="hinge" axis="0 0 1"
               range="0 1.57079632679" limited="true"/>
        <inertial pos="0.48966 -0.0243 0.26660" mass="15.0"
                  diaginertia="5.80 5.10 0.95"/>
        <geom name="leaf_collision" type="box"
              pos="0.48966 -0.0243 0.26660"
              size="0.48966 0.0243 1.06564"
              rgba="0.45 0.25 0.12 1"/>

        <body name="handle" pos="0.866628 -0.077827 0.101401"
              quat="0 0 1 0">
          <joint name="handle_hinge" type="hinge" axis="0 1 0"
                 range="-0.6412635576 0.2844535343" limited="true"
                 frictionloss="0.5"/>
          <!--
            The authored handle body is rotated 180 degrees about local Y, so
            local +X points toward the inboard/left side of the visible door
            handle.  Keep both the collision lever and its COM on that side.
          -->
          <inertial pos="0.075 0 0" mass="0.35"
                    diaginertia="0.0004 0.0012 0.0012"/>
          <geom name="handle_hub" type="cylinder" pos="0 0 0"
                quat="0.70710678 0.70710678 0 0"
                size="0.035 0.035" rgba="0.15 0.15 0.15 1"/>
          <geom name="handle_lever" type="capsule"
                fromto="0 0 0 0.18 0 0" size="0.018"
                rgba="0.12 0.12 0.12 1"/>
        </body>
      </body>
    </body>
  </worldbody>
  <!-- HumanoidArena configures the door articulation with self-collision
       disabled.  Keep robot-to-door contacts, but do not let the frame, leaf,
       and handle jam one another at the authored closed pose. -->
  <contact>
    <exclude name="frame_leaf" body1="door_root" body2="leaf"/>
    <exclude name="frame_handle" body1="door_root" body2="handle"/>
    <exclude name="leaf_handle" body1="leaf" body2="handle"/>
  </contact>
</mujoco>
